{
  "name": "video-x film catalog",
  "version": "2026.11 v3",
  "basis": "feat/film-catalog app code; no interaction structure copied from prior design directories",
  "colors": {
    "cinema": {
      "ink": "#0a0a0b",
      "ink2": "#111113",
      "ink3": "#18181b",
      "ivory": "#f1efea",
      "ivory2": "#d0ccc3",
      "ivory3": "#928d84",
      "ivory4": "#66625b",
      "brass": "#c7a25c",
      "brassBright": "#e1c58e",
      "line": "rgba(241,239,234,0.11)",
      "lineStrong": "rgba(241,239,234,0.24)"
    },
    "archive": {
      "paper": "#f3f1ec",
      "paper2": "#eae7df",
      "paper3": "#dfdbd1",
      "ink": "#1d1c19",
      "ink2": "#44413a",
      "muted": "#777168",
      "line": "#d5d0c5",
      "lineStrong": "#b9b2a4",
      "oxblood": "#8d3b31",
      "sage": "#5d6b58",
      "amber": "#9e6b2e"
    }
  },
  "typography": {
    "display": "\"Avenir Next\", \"SF Pro Display\", \"Helvetica Neue\", \"PingFang SC\", sans-serif",
    "sans": "\"PingFang SC\", \"Hiragino Sans GB\", \"Microsoft YaHei\", -apple-system, sans-serif",
    "mono": "\"SF Mono\", \"Menlo\", \"Monaco\", \"IBM Plex Mono\", monospace",
    "note": "No serif family. Songti / STSong are intentionally absent."
  },
  "density": {
    "viewingLibraryColumns": 7,
    "mobileFilmColumns": 3,
    "mobileSeriesColumns": 2,
    "adminTableRow": "66-72px",
    "adminCountBar": "50px",
    "adminPageHeader": "approx. 90-110px",
    "mobileCategoryButton": "44px",
    "mobileBottomNav": "62px"
  },
  "motion": {
    "hover": "160ms",
    "drawer": "380ms cubic-bezier(0.16,1,0.3,1)",
    "pageEnter": "600-800ms",
    "reducedMotion": "disabled via prefers-reduced-motion"
  },
  "accessibility": {
    "focus": "1px accent outline, 3px offset",
    "touch": "44px minimum on mobile",
    "state": "dot + text label, never color alone",
    "contrast": "4.5:1 target for body and operable text"
  }
}
